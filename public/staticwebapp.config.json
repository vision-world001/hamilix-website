{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/images/*",
      "/logos/*",
      "/*.{js,css,png,jpg,jpeg,gif,ico,svg,webp,woff,woff2,json,map,txt,xml}"
    ]
  },
  "mimeTypes": {
    ".js": "application/javascript",
    ".mjs": "application/javascript",
    ".json": "application/json",
    ".webp": "image/webp",
    ".woff2": "font/woff2"
  }
}
